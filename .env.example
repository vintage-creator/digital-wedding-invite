# Supabase persistence and guest photo storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
# Newer Supabase projects may call this the publishable key. Either this or
# VITE_SUPABASE_ANON_KEY can be used by the app.
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Optional invitation gate. Defaults to DT2026 when not set.
VITE_INVITATION_CODE=DT2026

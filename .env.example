# Supabase persistence and guest photo storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
# Newer Supabase projects may call this the publishable key. Either this or
# VITE_SUPABASE_ANON_KEY can be used by the app.
VITE_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key

# Optional invitation gate. Defaults to EVERAFTER21 when not set.
VITE_INVITATION_CODE=EVERAFTER21

# Optional licensed background track. Add the file to public/assets when using a local path.
VITE_WEDDING_MUSIC_URL=/assets/unbreakable-westlife.mp3

# Optional bank transfer details. Leave blank until the couple supplies the correct details.
VITE_GIFT_BANK_NAME=
VITE_GIFT_ACCOUNT_NAME=
VITE_GIFT_ACCOUNT_NUMBER=

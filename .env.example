# Safe client-side Cloudinary settings for guest photo uploads.
# Create an unsigned upload preset in Cloudinary Settings > Upload.
VITE_CLOUDINARY_CLOUD_NAME=doam8l8j9
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Never add CLOUDINARY_API_SECRET to a Vite/browser environment variable.

# Supabase RSVP persistence (the anon key is designed for browser use with RLS).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
